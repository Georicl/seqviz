{
  "theme": "dark",
  "browser": {
    "wrap_width": 60,
    "auto_wrap": true,
    "scroll_step": 5,
    "sidebar_width": 32,
    "show_line_numbers": true,
    "show_quality": true
  },
  "colors": {
    "dna": {
      "A": "green",
      "T": "red",
      "C": "blue",
      "G": "yellow",
      "N": "dim"
    },
    "quality_thresholds": {
      "high": 30,
      "medium": 20,
      "low": 10
    }
  },
  "file_browser": {
    "extensions": [
      ".fa",
      ".fasta",
      ".fna",
      ".faa",
      ".aa",
      ".seq",
      ".fq",
      ".fastq"
    ]
  }
}
